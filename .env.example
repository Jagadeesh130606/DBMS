# ==========================================
# RESEARCH PAPER DISCOVERY & RECOMMENDATION
# ENVIRONMENT CONFIGURATION
# ==========================================

# PostgreSQL Connection Configuration
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/research_paper_db
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgrespassword
PG_DATABASE=research_paper_db

# MongoDB Connection Configuration
MONGODB_URI=mongodb://localhost:27017/research_paper_db

# JWT & Authentication Secret
JWT_SECRET=research-paper-discovery-jwt-secret-key-2026

# Node Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Embedding Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Execution Driver (auto | pg | pglite)
# "auto" detects if PostgreSQL is listening on 5432; if not, uses embedded PGlite + pgvector for zero-setup execution.
POSTGRES_MODE=auto
